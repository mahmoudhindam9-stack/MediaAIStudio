PORT=3000
# Must match MEDIA_AI_BACKEND_API_KEY supplied to the Android build.
MEDIA_AI_BACKEND_API_KEY=replace-with-a-long-random-token
# Public origin only, without /v1/ai.
PUBLIC_BASE_URL=https://your-ai-backend.example.com

# Provider credentials; keep these on the backend only.
GEMINI_API_KEY=
# Legacy alias is also accepted:
GOOGLE_AI_API_KEY=
FAL_KEY=

IMAGE_MODEL=gemini-nano-banana-2.1
VIDEO_MODEL=veo-3.1-fast-generate-preview
TRANSCRIPTION_MODEL=gemini-3.8-flash
TRELLIS_MODEL_ID=fal-ai/trellis
TRELLIS_MAX_POLLS=180
TRELLIS_POLL_INTERVAL_MS=3000
