# Android app -> MediaAIStudio backend connection
MEDIA_AI_BACKEND_URL=https://your-ai-backend.example.com/v1/ai
# Must match backend/.env's MEDIA_AI_BACKEND_API_KEY. This app token is extractable,
# so protect a public deployment with server-side rate limits and user authentication too.
MEDIA_AI_BACKEND_API_KEY=replace-with-the-same-backend-token

# Do NOT put GEMINI_API_KEY / GOOGLE_AI_API_KEY / FAL_KEY in this file.
# Configure model-provider secrets only in the backend environment.
# GEMINI_API_KEY enables Gemini image processing and Veo image/text-to-video.
# FAL_KEY enables the hosted TRELLIS image-to-3D provider.
