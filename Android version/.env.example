# Copy this file to .env for local Android builds.
# Empty values are represented as valid Java string literals for the Secrets Gradle plugin.
# Keep real credentials out of version control. CI can provide these as environment variables.
MEDIA_AI_BACKEND_URL=""
MEDIA_AI_BACKEND_API_KEY=""
PERMANENT_RELEASE_CERT_SHA256=""
RELEASE_CERT_SHA256=""
RELEASE_KEYSTORE_PATH=""
RELEASE_STORE_PASSWORD=""
RELEASE_KEY_ALIAS=""
RELEASE_KEY_PASSWORD=""
